# Solana RPC (optional; defaults to devnet)
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# X (Twitter) OAuth 1.0a — required for "Connect X" (check-for-vibe + claim)
# See docs/X_OAUTH_ENV.md for how to get these from https://developer.twitter.com/
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_CALLBACK_URL=http://localhost:3000/api/auth/x/callback
# Optional: separate secret for iOS Safari fallback token (defaults to X_CONSUMER_SECRET)
# X_AUTH_TOKEN_SECRET=

# Public app URL (required for X card unfurl; use your deployed URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Vibe Authority Keypair — required for minting and transferring NFTs
# -----------------------------------------------------------------------------
# This is the backend authority that:
# 1. Holds NFTs in "vault" until claimed
# 2. Signs transfer transactions when vibes are claimed
# 
# Generate with: solana-keygen new --outfile authority.json
# Then convert to base58: node -e "console.log(require('bs58').encode(require('./authority.json')))"
# 
# IMPORTANT: Keep this secret! Never commit to git.
VIBE_AUTHORITY_SECRET=

# -----------------------------------------------------------------------------
# Treasury Wallet — receives micro-fees from mints and claims
# -----------------------------------------------------------------------------
# Public key where fees are collected (your wallet to receive revenue)
TREASURY_WALLET=

# Treasury Wallet Private Key (optional, for transferring funds out)
# Base58-encoded secret key. Only needed if you want to use the transfer script.
# IMPORTANT: Keep this secret! Never commit to git.
# TREASURY_SECRET=

# Fee amounts in lamports (1 SOL = 1,000,000,000 lamports)
# Mint fee: 0.002 SOL ≈ $0.30 at $150/SOL
MINT_FEE_LAMPORTS=2000000
# Claim fee: 0.001 SOL ≈ $0.15 at $150/SOL
CLAIM_FEE_LAMPORTS=1000000

# -----------------------------------------------------------------------------
# Storage — Network-based automatic selection
# -----------------------------------------------------------------------------
# The code automatically picks storage based on network:
#   - Mainnet → Uses Irys/Arweave (permanent, decentralized)
#   - Devnet  → Uses Vercel Blob (or local filesystem if no blob token)
#
# Configure BOTH for production deployments. The code picks the right one
# based on NEXT_PUBLIC_SOLANA_RPC.

# Irys/Arweave — for MAINNET (permanent storage)
# Fund your Irys account first:
#   npx @irys/sdk fund 100000000 -n mainnet -t solana -w ./authority.json
#   (0.1 SOL = ~1000 uploads)
IRYS_WALLET_SECRET=

# Vercel Blob — for DEVNET (get token from Vercel dashboard → Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# Supabase — Database for vibe records
# -----------------------------------------------------------------------------
# Create a project at https://supabase.com/dashboard
# Get these from Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
